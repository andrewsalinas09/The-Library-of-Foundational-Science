---
import "../styles/global.css";
import "../styles/prose.css";
import "katex/dist/katex.min.css";

interface Props {
  title: string;
  description?: string;
  /** Renders the reading progress rail. Only meaningful on documents. */
  progress?: boolean;
}

const { title, description = "", progress = false } = Astro.props;
const hasSidebar = Astro.slots.has("sidebar");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={Astro.url.pathname} />

    {/* Apply the stored theme before first paint so there is no flash. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (err) {
          /* private mode: fall back to the system preference */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    {progress && (
      <div class="progress" aria-hidden="true">
        <div class="progress__bar" id="progress-bar"></div>
      </div>
    )}

    <div class="topbar">
      {hasSidebar && (
        <button
          class="icon-button topbar__menu"
          id="sidebar-toggle"
          type="button"
          aria-label="Open contents"
          aria-expanded="false"
          aria-controls="sidebar"
        >
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <path d="M2 4h12M2 8h12M2 12h12" />
          </svg>
        </button>
      )}

      <button class="icon-button" id="theme-toggle" type="button" aria-label="Switch theme">
        <svg class="icon-sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
          <circle cx="8" cy="8" r="3.1" />
          <path d="M8 1v1.6M8 13.4V15M15 8h-1.6M2.6 8H1M12.9 3.1l-1.1 1.1M4.2 11.8l-1.1 1.1M12.9 12.9l-1.1-1.1M4.2 4.2L3.1 3.1" />
        </svg>
        <svg class="icon-moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
          <path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.9 5.9 0 1 0 7.1 7.1Z" />
        </svg>
      </button>
    </div>

    {hasSidebar && <div class="sidebar__scrim" id="sidebar-scrim"></div>}

    <div class="shell">
      {hasSidebar && (
        <aside class="sidebar" id="sidebar">
          <slot name="sidebar" />
        </aside>
      )}
      <main class="main" id="content">
        <slot />
      </main>
    </div>

    <script>
      const root = document.documentElement;

      /* ---------------------------------------------------------- theme */
      const themeToggle = document.getElementById("theme-toggle");
      const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

      function currentTheme(): "light" | "dark" {
        const explicit = root.getAttribute("data-theme");
        if (explicit === "dark" || explicit === "light") return explicit;
        return systemDark.matches ? "dark" : "light";
      }

      themeToggle?.addEventListener("click", () => {
        const next = currentTheme() === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try {
          localStorage.setItem("theme", next);
        } catch (err) {
          /* ignore */
        }
        document.dispatchEvent(
          new CustomEvent("themechange", { detail: { theme: next } }),
        );
      });

      /* -------------------------------------------------------- sidebar */
      const sidebar = document.getElementById("sidebar");
      const scrim = document.getElementById("sidebar-scrim");
      const sidebarToggle = document.getElementById("sidebar-toggle");

      function setSidebar(open: boolean) {
        sidebar?.setAttribute("data-open", String(open));
        scrim?.setAttribute("data-open", String(open));
        sidebarToggle?.setAttribute("aria-expanded", String(open));
      }

      sidebarToggle?.addEventListener("click", () => {
        setSidebar(sidebar?.getAttribute("data-open") !== "true");
      });
      scrim?.addEventListener("click", () => setSidebar(false));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setSidebar(false);
      });
      sidebar?.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) setSidebar(false);
      });

      /* ------------------------------------------- progress + scrollspy */
      const article = document.querySelector<HTMLElement>(".prose");
      const bar = document.getElementById("progress-bar");
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(".toc__link"),
      );
      const targets = tocLinks
        .map((link) => {
          const id = decodeURIComponent(link.hash.slice(1));
          const el = id ? document.getElementById(id) : null;
          return el ? { link, el } : null;
        })
        .filter((entry): entry is { link: HTMLAnchorElement; el: HTMLElement } =>
          Boolean(entry),
        );

      let ticking = false;

      function update() {
        ticking = false;

        if (bar && article) {
          const start = article.offsetTop;
          const span = article.offsetHeight - window.innerHeight;
          const progressed = span > 0 ? (window.scrollY - start) / span : 1;
          bar.style.width = `${Math.min(100, Math.max(0, progressed * 100))}%`;
        }

        if (targets.length) {
          let active = targets[0];
          for (const entry of targets) {
            if (entry.el.getBoundingClientRect().top <= 140) active = entry;
            else break;
          }
          for (const { link } of targets) link.removeAttribute("aria-current");
          active.link.setAttribute("aria-current", "true");
        }
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();

      /* --------------------------------------------------------- mermaid */
      /* The Mermaid bundle is ~3.5 MB. Fetch it only when the page actually
         contains a diagram: Vite splits this dynamic import into its own
         chunk, so a document with no diagram never requests a byte of it. */
      (async () => {
        const diagrams = Array.from(
          document.querySelectorAll<HTMLElement>("pre.mermaid"),
        );
        if (diagrams.length === 0) return;

        for (const block of diagrams) {
          block.dataset.source = block.textContent ?? "";
        }

        const { default: mermaid } = await import("mermaid");

        async function draw() {
          const styles = getComputedStyle(document.body);
          mermaid.initialize({
            startOnLoad: false,
            securityLevel: "strict",
            theme: currentTheme() === "dark" ? "dark" : "neutral",
            fontFamily:
              styles.getPropertyValue("--font-ui").trim() || "sans-serif",
          });

          for (const block of diagrams) {
            block.textContent = block.dataset.source ?? "";
            block.removeAttribute("data-processed");
          }

          try {
            await mermaid.run({ nodes: diagrams });
          } catch (err) {
            console.error("[mermaid] failed to render a diagram", err);
          }
        }

        await draw();
        document.addEventListener("themechange", draw);
        systemDark.addEventListener("change", () => {
          if (!root.hasAttribute("data-theme")) draw();
        });
      })();

      /* ------------------------------------------------- glossary on tap */
      /* Hover handles pointer devices in CSS; touch needs an explicit open. */
      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        const term = target.closest<HTMLElement>(".gloss");
        document
          .querySelectorAll<HTMLElement>('.gloss[data-open="true"]')
          .forEach((el) => {
            if (el !== term) el.removeAttribute("data-open");
          });
        if (term && window.matchMedia("(hover: none)").matches) {
          const open = term.getAttribute("data-open") === "true";
          term.setAttribute("data-open", String(!open));
        }
      });
    </script>
  </body>
</html>
